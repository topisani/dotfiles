#!/usr/bin/env -S uv run -s
#
# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "lsprotocol==2024.0.0b1",
#     "pygls==2.0.0a2",
#     "click",
#     "pyyaml",
# ]
# ///

# Kconfig/devicetree language server for Zephyr west workspaces.
#
# All configuration is reconstructed from build artifacts that Zephyr's CMake
# build already generates (build_info.yml, Kconfig/kconfig_module_dirs.env and
# the menuconfig target in build.ninja). No init step or cmake hook is needed:
# build the project once and the LSP picks up the latest build's configuration.


import enum
import itertools
import json
import logging
import os
import re
import shlex
import subprocess
import sys
import threading
from pathlib import Path
from typing import Any

import click
import yaml


def mod_kconfig_lsp():
    import re
    import os.path
    import importlib
    from lsprotocol import types
    from pygls.lsp.server import LanguageServer

    class Filetype(enum.Enum):
        UNKNOWN = enum.auto()
        KCONFIG = enum.auto()
        CONF = enum.auto()
        DEVICETREE = enum.auto()

        @staticmethod
        def from_uri(uri: str) -> "Filetype":
            path = Path.from_uri(uri)
            if path.name.startswith("Kconfig"):
                return Filetype.KCONFIG
            if path.name.endswith("_defconfig"):
                return Filetype.CONF
            if path.name.endswith(".conf"):
                return Filetype.CONF
            if path.name.endswith(".dts"):
                return Filetype.DEVICETREE
            if path.name.endswith(".dtsi"):
                return Filetype.DEVICETREE
            if path.name.endswith(".overlay"):
                return Filetype.DEVICETREE
            return Filetype.UNKNOWN

        def is_dts(self) -> bool:
            return self == self.DEVICETREE

        def is_kconfig(self) -> bool:
            return self == self.KCONFIG or self == self.CONF

    ###############################################################################
    # Kconfig Language Server                                                     #
    ###############################################################################

    class KconfigIndex:
        class Symbol: ...

        def __init__(self):
            self._init_import()
            self.kconf = self.__kcl.Kconfig(
                os.getenv("WEST_LSP_KCONFIG_ROOT"), suppress_traceback=True
            )
            self.kconf.load_config()

        def _init_import(self):
            try:
                ZEPHYR_BASE = os.getenv("ZEPHYR_BASE")
                if not ZEPHYR_BASE:
                    logging.fatal("Missing ZEPHYR_BASE environment variable")
                    exit(1)
                sys.path.insert(0, os.path.join(ZEPHYR_BASE, "scripts", "kconfig"))
                self.__kcl = importlib.import_module("kconfiglib")
            except ImportError as e:
                logging.fatal(f"Could not import kconfiglib: {e}")
                exit(1)

        def symbols(self, visible_only=False) -> list[Symbol]:
            syms = self.kconf.unique_defined_syms
            if visible_only:
                return filter(lambda s: s.visibility != 0, syms)
            return syms

        def find_symbol(self, name: str) -> Symbol | None:
            m = re.search("(CONFIG_)?(\\w*)", name)
            sym_name = m.group(2)
            if not sym_name:
                return None

            for sym in self.symbols():
                if sym.name == sym_name:
                    return sym
            else:
                return None

        def sym_prefix_for(self, document_uri: str) -> str:
            ft = Filetype.from_uri(document_uri)
            if ft == Filetype.KCONFIG:
                return ""
            return "CONFIG_"

        def filename_to_uri(self, filename: str) -> str:
            path = Path(filename)
            if not path.is_absolute():
                base = os.getenv("srctree")
                path = Path(base) / path
            return path.resolve().as_uri()

        def sym_prompt(self, sym: Symbol) -> str:
            prompt = []
            for node in sym.nodes:
                if node.prompt:
                    prompt.append(node.prompt[0])
            return "\n".join(prompt)

        def sym_help(self, sym: Symbol) -> str:
            help = []
            if sym.nodes:
                for node in sym.nodes:
                    if node.help:
                        help.append(node.help)
            return "\n\n".join(help)

        def sym_value(self, sym: Symbol) -> str:
            return (
                sym.str_value
                if sym.orig_type in self.__kcl._BOOL_TRISTATE
                else '"{}"'.format(sym.str_value)
            )

        def sym_description(self, sym: Symbol, prompt=True, nodes=True):
            """
            Returns a string with information about the symbol (including its name,
            value, visibility, and location(s)) when it is evaluated on e.g. the
            interactive Python prompt.
            """
            fields = []
            add = fields.append

            add(sym.name + "=" + self.sym_value(sym))

            if prompt:
                promptstr = self.sym_prompt(sym)
                if promptstr:
                    add(promptstr)
                    add("")

            helpstr = self.sym_help(sym)
            if helpstr:
                add(helpstr)
                add("")

            add("type: " + self.__kcl.TYPE_TO_STR[sym.type])

            if not sym.is_constant:
                # These aren't helpful to show for constant symbols
                add("visibility: " + self.__kcl.TRI_TO_STR[sym.visibility])

                if sym.choice:
                    add("choice symbol")

                if sym.is_allnoconfig_y:
                    add("allnoconfig_y")

                if sym is sym.kconfig.defconfig_list:
                    add("is the defconfig_list symbol")

                if sym.env_var is not None:
                    add("from environment variable " + sym.env_var)

                if sym is sym.kconfig.modules:
                    add("is the modules symbol")

                add(
                    "direct deps: "
                    + self.__kcl.TRI_TO_STR[self.__kcl.expr_value(sym.direct_dep)]
                )
            if nodes:
                if sym.nodes:
                    for node in sym.nodes:
                        add("")
                        add("{}:{}".format(node.filename, node.linenr))
                        add(str(node))

            return "\n".join(fields)

    class KconfLsp(LanguageServer):
        kc: KconfigIndex

        def __init__(self, *args, **kwargs):
            super().__init__(*args, **kwargs)

        def load_env(self):
            self.kc = KconfigIndex()

        def kc_sym_at(
            self, document_uri: str, pos: types.Position
        ) -> KconfigIndex.Symbol | None:
            token = self.token_at_cursor(document_uri, pos)
            return self.kc.find_symbol(token)

        def token_at_cursor(
            self, document_uri: str, pos: types.Position, before=True, after=True
        ) -> str | None:
            document = self.workspace.get_text_document(document_uri)

            def is_word_char(c: str):
                return c.isalpha() or c.isdigit() or c == "_"

            try:
                line = document.lines[pos.line]

                start = pos.character
                end = pos.character
                if before:
                    if start > 0 and is_word_char(line[start - 1]):
                        start -= 1
                    while start > 0 and is_word_char(line[start]):
                        start -= 1

                if after:
                    while end < len(line) and end >= 0 and is_word_char(line[end]):
                        end += 1
                return line[start:end].strip()

            except IndexError:
                return None

    server = KconfLsp("kconfig-lsp", "v0.1")

    @server.feature(types.TEXT_DOCUMENT_HOVER)
    def hover(ls: KconfLsp, params: types.HoverParams):
        document_uri = params.text_document.uri
        pos = params.position

        sym = ls.kc_sym_at(document_uri, pos)

        if not sym:
            return None

        return types.Hover(
            contents=types.MarkupContent(
                kind=types.MarkupKind.PlainText,
                value=ls.kc.sym_description(sym),
            ),
            range=types.Range(
                start=types.Position(line=pos.line, character=0),
                end=types.Position(line=pos.line + 1, character=0),
            ),
        )

    @server.feature(types.TEXT_DOCUMENT_DEFINITION)
    def goto_declaration(ls: KconfLsp, params: types.DefinitionParams):
        """Jump to an object's declaration."""
        document_uri = params.text_document.uri
        pos = params.position

        sym = ls.kc_sym_at(document_uri, pos)

        if not sym:
            return None

        return [
            types.Location(
                uri=ls.kc.filename_to_uri(node.filename),
                range=types.Range(
                    start=types.Position(line=node.linenr - 1, character=0),
                    end=types.Position(line=node.linenr - 1, character=0),
                ),
            )
            for node in sym.nodes
        ]

    @server.feature(
        types.TEXT_DOCUMENT_COMPLETION,
        types.CompletionOptions(resolve_provider=True),
    )
    def completions(
        ls: KconfLsp, params: types.CompletionParams | None = None
    ) -> types.CompletionList:
        """Returns completion items."""
        document_uri = params.text_document.uri

        token = ls.token_at_cursor(document_uri, params.position, after=False)
        if len(token) == 0:
            return None

        prefix = ls.kc.sym_prefix_for(document_uri)

        symbols = [
            s
            for s in ls.kc.symbols(visible_only=True)
            if (prefix + s.name).startswith(token)
        ]

        MAX_ITEMS = 20
        return types.CompletionList(
            is_incomplete=len(symbols) > MAX_ITEMS,
            items=itertools.islice(
                (types.CompletionItem(label=(prefix + s.name)) for s in symbols),
                MAX_ITEMS,
            ),
        )

    @server.feature(types.COMPLETION_ITEM_RESOLVE)
    def resolve_completion(
        ls: KconfLsp, item: types.CompletionItem
    ) -> types.CompletionItem:
        if s := ls.kc.find_symbol(item.label):
            item.detail = ls.kc.sym_prompt(s)
            item.documentation = ls.kc.sym_description(s, prompt=False)
        return item

    return server


###############################################################################
# Build metadata discovery                                                    #
###############################################################################


def find_workspace_root(start: Path | None = None) -> Path | None:
    """Find the west workspace root (the directory containing .west/)."""
    start = Path(start) if start else Path.cwd()
    for base in [start, *start.parents]:
        if (base / ".west").is_dir():
            return base
    return None


def find_build_info(root_dir: Path) -> Path | None:
    """Find the most recently modified app build_info.yml under root_dir.

    Prefers the conventional build/ directory to avoid walking the whole tree,
    and skips sysbuild's `_sysbuild` directory in favor of the application
    build directory (the one whose Kconfig the editor should index).
    """
    search_dir = root_dir / "build"
    if not search_dir.is_dir():
        search_dir = root_dir

    candidates = sorted(
        (
            p
            for p in search_dir.rglob("build_info.yml")
            if (p.parent / "Kconfig").is_dir()
        ),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    # With sysbuild, the top-level build dir only holds SB_CONFIG_* symbols;
    # prefer an image build dir (e.g. build/<dir>/app) with a real CONFIG_ tree.
    for p in candidates:
        if parse_kconfig_env(p.parent).get("CONFIG_") == "CONFIG_":
            return p
    return candidates[0] if candidates else None


def parse_kconfig_env(build_dir: Path) -> dict[str, str]:
    """Extract the full Kconfig environment from build.ninja.

    Zephyr's kconfig.cmake generates menuconfig/guiconfig targets that invoke
    `cmake -E env <VAR=VALUE>... <python> <script>`. That env list is exactly
    what Kconfig needs to re-parse the tree, so scrape it from there.
    """
    ninja = build_dir / "build.ninja"
    try:
        text = ninja.read_text(errors="replace")
    except OSError:
        return {}

    for line in text.splitlines():
        if not re.search(r"(menuconfig|guiconfig)\.py", line):
            continue
        env = {}
        for tok in shlex.split(line):
            m = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)=(.*)", tok)
            if m:
                env[m.group(1)] = m.group(2)
        if env:
            return env
    return {}


def kconfig_env(build_dir: Path) -> dict[str, str]:
    """Reconstruct the environment needed to load the app's Kconfig tree."""
    env: dict[str, str] = {}

    build_info_path = build_dir / "build_info.yml"
    info = {}
    if build_info_path.exists():
        with open(build_info_path) as f:
            info = yaml.safe_load(f) or {}

    cmake = getkey(info, "cmake") or {}
    zephyr_base = getkey(cmake, "zephyr", "zephyr-base")
    app_dir = getkey(cmake, "application", "configuration-dir")

    # Baseline from build_info.yml, in case build.ninja is unavailable
    if zephyr_base:
        env["ZEPHYR_BASE"] = zephyr_base
        env["srctree"] = zephyr_base
    if board := cmake.get("board"):
        env["BOARD"] = board.get("name", "")
        env["BOARD_QUALIFIERS"] = board.get("qualifiers") or ""
        env["BOARD_REVISION"] = board.get("revision") or ""
    if app := cmake.get("application"):
        env["APPLICATION_SOURCE_DIR"] = app.get("source-dir", "")
    if toolchain_path := getkey(cmake, "toolchain", "path"):
        env["ZEPHYR_SDK_INSTALL_DIR"] = toolchain_path
    env["KCONFIG_BINARY_DIR"] = (build_dir / "Kconfig").as_posix()
    env["KCONFIG_BOARD_DIR"] = (build_dir / "Kconfig/boards").as_posix()
    dotconfig = build_dir / "zephyr/.config"
    if dotconfig.exists():
        env["KCONFIG_CONFIG"] = dotconfig.as_posix()

    # Authoritative values scraped from build.ninja override the baseline
    env.update(parse_kconfig_env(build_dir))

    # ZEPHYR_<MODULE>_MODULE_DIR variables used by Kconfig.modules
    module_dirs = build_dir / "Kconfig/kconfig_module_dirs.env"
    if module_dirs.exists():
        for line in module_dirs.read_text().splitlines():
            k, _, v = line.partition("=")
            if v:
                env[k] = v

    if app_dir:
        env["WEST_LSP_KCONFIG_ROOT"] = str(Path(app_dir) / "Kconfig")

    return env


###############################################################################
# Commands                                                                    #
###############################################################################


@click.group()
def app():
    pass


def getkey(d: Any, *args) -> Any:
    if len(args) == 0:
        return d
    try:
        if len(args) == 1:
            return d[args[0]]
        return getkey(d[args[0]], *args[1:])
    except (KeyError, TypeError):
        return None


@app.command()
@click.option("--build-dir", required=False, type=Path, help="Build directory to use")
def kconfig_lsp(build_dir: Path | None):
    logging.basicConfig(level=logging.INFO, format="%(message)s")

    if build_dir is None:
        root = find_workspace_root() or Path.cwd()
        build_info = find_build_info(root)
        if build_info is None:
            logging.fatal(
                f"No build_info.yml found under {root}. Build the project first."
            )
            exit(1)
        build_dir = build_info.parent

    logging.info(f"Using build directory: {build_dir}")
    os.environ.update(kconfig_env(build_dir))

    server = mod_kconfig_lsp()
    server.load_env()
    server.start_io()


def dts_settings(root_dir: Path) -> dict:
    """Build devicetree-language-server settings from build_info.yml metadata."""

    def context(info: dict):
        try:
            return {
                "bindingType": "Zephyr",
                "zephyrBindings": info["cmake"]["devicetree"]["bindings-dirs"],
                "includePaths": info["cmake"]["devicetree"]["include-dirs"],
                "dtsFile": info["cmake"]["devicetree"]["files"][0],
                "overlays": info["cmake"]["devicetree"]["files"][1:],
            }
        except (KeyError, IndexError):
            return None

    search_dir = root_dir / "build"
    if not search_dir.is_dir():
        search_dir = root_dir

    # One context per image build (sysbuild may produce several), newest first
    candidates = sorted(
        search_dir.rglob("build_info.yml"),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )

    contexts = []
    for p in candidates:
        with open(p) as f:
            info = yaml.safe_load(f) or {}
        if c := context(info):
            contexts.append(c)

    return {"contexts": contexts, "preferredContext": 0}


def read_frame(stream) -> bytes | None:
    """Read one Content-Length framed JSON-RPC message."""
    length = None
    while True:
        line = stream.readline()
        if not line:
            return None
        line = line.rstrip(b"\r\n")
        if not line:
            break
        k, _, v = line.partition(b":")
        if k.lower() == b"content-length":
            length = int(v)
    return stream.read(length) if length else None


def write_frame(stream, body: bytes):
    stream.write(b"Content-Length: %d\r\n\r\n" % len(body) + body)
    stream.flush()


def pump(src, dst, close_dst=False):
    # read1 (not read) so data is forwarded as soon as it arrives; a blocking
    # read(n) would stall until the buffer fills and the server would appear
    # to never answer requests.
    try:
        while chunk := src.read1(65536):
            dst.write(chunk)
            dst.flush()
    finally:
        if close_dst:
            dst.close()


@app.command()
@click.option("--root-dir", required=False, type=Path)
def dts_lsp(root_dir: Path | None):
    """Run devicetree-language-server with settings injected from build metadata.

    Acts as a stdio proxy: computes the devicetree LS settings from the
    workspace's build_info.yml, injects them into the initialize request's
    initializationOptions, then passes all traffic through untouched. This
    keeps editor-side configuration static (no settings baked into the
    editor config at startup).
    """
    root_dir = root_dir or find_workspace_root() or Path.cwd()
    settings = dts_settings(root_dir)
    if not settings["contexts"]:
        logging.error(f"No devicetree build metadata found under {root_dir}")

    child = subprocess.Popen(
        ["npm", "x", "--", "devicetree-language-server", "--stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
    )

    stdin = sys.stdin.buffer
    frame = read_frame(stdin)
    if frame is None:
        child.terminate()
        return
    msg = json.loads(frame)
    if msg.get("method") == "initialize":
        opts = msg.setdefault("params", {}).setdefault("initializationOptions", {})
        opts.setdefault("settings", {})["devicetree"] = settings
        frame = json.dumps(msg).encode()
    write_frame(child.stdin, frame)

    threading.Thread(
        target=pump, args=(stdin, child.stdin), kwargs={"close_dst": True}, daemon=True
    ).start()
    pump(child.stdout, sys.stdout.buffer)
    child.wait()


if __name__ == "__main__":
    app()

