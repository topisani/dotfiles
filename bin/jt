#!/usr/bin/env bash
# jt is a Go program; its source is ../jt. This builds it on first use and again
# whenever the source changes, so a dotfiles pull is all an update takes. Each
# machine and container gets its own binary, in its own ~/.cache.
set -u
self=$(readlink -f "${BASH_SOURCE[0]}")
src=${self%/bin/jt}/jt
bin=${XDG_CACHE_HOME:-$HOME/.cache}/jt/jt

if [[ ! -x $bin || -n $(find "$src" -type f -newer "$bin" -print -quit 2>/dev/null) ]]; then
  if command -v go >/dev/null 2>&1; then
    mkdir -p "${bin%/*}"
    tmp=$(mktemp "$bin.XXXXXX")
    # Build to a temp file and rename: parallel workers may all land here.
    if (cd "$src" && CGO_ENABLED=0 go build -trimpath -o "$tmp" .) >&2; then
      mv -f "$tmp" "$bin"
    else
      rm -f "$tmp"
      if [[ -x $bin ]]; then
        echo "jt: build failed, running the old binary" >&2
      else
        echo "jt: build failed" >&2
        exit 1
      fi
    fi
  elif [[ ! -x $bin ]]; then
    echo "jt: not built yet, and go isn't installed" >&2
    exit 1
  fi
fi
exec "$bin" "$@"
