#!/usr/bin/env bash
# jt — a task tracker built on jj changes.
#
# A task is any change whose description ends with a trailer block containing
# `Task-Status:`. The change id is the task id. Blockers are parent edges.
#
# Unlike a pure-revset board, status is parsed from the *trailer block* (the
# last paragraph of key: value lines) rather than substring-matched against the
# whole description — so a task that merely mentions "Task-Status: done" in its
# body is not silently misfiled. The revset is only a coarse prefilter.

set -euo pipefail

TASKS='description(substring:"Task-Status:")'
STATUSES="todo ready doing investigating blocked testing deferred done"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  c_id=$'\e[33m'; c_todo=$'\e[34m'; c_doing=$'\e[32m'; c_blocked=$'\e[31m'
  c_done=$'\e[90m'; c_inv=$'\e[35m'; c_prio=$'\e[35m'; c_needs=$'\e[36m'; c_off=$'\e[0m'
  c_testing=$'\e[93m'; c_defer=$'\e[37m'
else
  c_id=; c_todo=; c_doing=; c_blocked=; c_done=; c_inv=; c_prio=; c_needs=; c_off=
  c_testing=; c_defer=
fi

die() { printf 'jt: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- awk library

read -r -d '' AWKLIB <<'AWKEOF' || true
# Decode a JSON string literal (including surrounding quotes). jj's json() does
# not escape non-ASCII, so \uXXXX handling is a fallback we rarely hit.
function unesc(s,   out, i, c, n, L) {
  s = substr(s, 2, length(s) - 2)
  L = length(s); out = ""
  for (i = 1; i <= L; i++) {
    c = substr(s, i, 1)
    if (c != "\\") { out = out c; continue }
    i++; n = substr(s, i, 1)
    if (n == "n") out = out "\n"
    else if (n == "t") out = out "\t"
    else if (n == "r") out = out "\r"
    else if (n == "b") out = out "\b"
    else if (n == "f") out = out "\f"
    else if (n == "u") { out = out "?"; i += 4 }
    else out = out n
  }
  return out
}

function jesc(s,   out) {
  out = s
  gsub(/\\/, "\\\\", out); gsub(/"/, "\\\"", out)
  gsub(/\n/, "\\n", out);  gsub(/\t/, "\\t", out)
  gsub(/\r/, "\\r", out)
  return out
}

# Split desc into L[1..n]; find the trailer block; fill T[lowerkey]=value and
# ORDER[1..oc] with original key names. Returns the 1-based index of the first
# trailer line, or 0 if the description has no trailer block.
function parse(desc, L, T, ORDER,   n, i, start, ok, p, k, v, oc) {
  n = split(desc, L, "\n")
  while (n > 0 && L[n] ~ /^[ \t]*$/) n--
  if (n == 0) return 0
  start = n
  while (start > 1 && L[start - 1] !~ /^[ \t]*$/) start--
  for (i = start; i <= n; i++)
    if (L[i] !~ /^[A-Za-z][A-Za-z0-9-]*:[ \t]/) return 0
  oc = 0
  for (i = start; i <= n; i++) {
    p = index(L[i], ":")
    k = substr(L[i], 1, p - 1)
    v = substr(L[i], p + 1)
    sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
    T[tolower(k)] = v
    ORDER[++oc] = k
  }
  ORDER[0] = oc
  return start
}

# Body = everything before the trailer block, trailing blanks trimmed.
function body_of(L, start,   i, out, last) {
  last = start - 1
  while (last > 0 && L[last] ~ /^[ \t]*$/) last--
  out = ""
  for (i = 1; i <= last; i++) out = out (i > 1 ? "\n" : "") L[i]
  return out
}
AWKEOF

# ------------------------------------------------------------------ jj access

# Emit one record per task: id \t parents \t empty \t json(description)
raw() {
  local rev="${1:-$TASKS}"
  jj log -r "$rev" --no-graph --reversed --ignore-working-copy -T \
    'change_id.shortest(8) ++ "\t" ++ parents.map(|p| p.change_id().shortest(8)).join(" ") ++ "\t" ++ if(empty,"1","0") ++ "\t" ++ json(description) ++ "\n"'
}

# Revset for the graph views (jt list --tree, jt ui). Including parents($TASKS)
# connects the tasks into one component: jj draws a trailing "~" per
# *disconnected* component, so without it you get one per task.
ui_revset() { printf '(%s) | @ | parents(%s)' "$TASKS" "$TASKS"; }

# Task-aware log template, shared by `jt list --tree` and the jjui config block.
# jj's `trailers` keyword does real git-trailer parsing — verified that it reads
# only the trailer block, not a "Task-Status:" line planted in the body.
# First line matches what a normal commit gets (format_short_commit_header,
# same as builtin_log_compact) so tasks and regular commits read the same way
# in a mixed graph; task metadata (status/priority/needs) rides on the second
# line, alongside the description rather than replacing it.
task_template() { cat <<'JTEOF'
if(trailers.contains_key("Task-Status"),
  label(
    separate(" ",
      if(current_working_copy, "working_copy"),
      if(immutable, "immutable", "mutable"),
      if(conflict, "conflicted"),
    ),
    concat(
      format_short_commit_header(self) ++ "\n",
      separate(" ",
        label("task_" ++ trailers.filter(|t| t.key()=="Task-Status").map(|t| t.value()).join(""),
          "[" ++ trailers.filter(|t| t.key()=="Task-Status").map(|t| t.value()).join("") ++ "]"),
        if(trailers.contains_key("Priority"),
          label("task_priority", "(" ++ trailers.filter(|t| t.key()=="Priority").map(|t| t.value()).join("") ++ ")")),
        if(empty, empty_commit_marker),
        if(description,
          description.first_line(),
          label(if(empty, "empty"), description_placeholder)),
        if(parents.any(|p| p.trailers().contains_key("Task-Status")),
          label("task_needs", "(needs " ++ parents.filter(|p| p.trailers().contains_key("Task-Status")).map(|p| p.change_id().shortest(8)).join(" ") ++ ")")),
      ) ++ "\n",
    ),
  ),
  builtin_log_compact
)
JTEOF
}

# Everything in `::@` is already IN the tree, so skipping a candidate does not
# drop its content — it just bases the next task LOWER, quietly building on a
# tree that is missing whatever sits above. Hence a DENYLIST of one: only
# `doing` is excluded, because that commit is being rewritten right now and
# stacking on it races the writer into a divergent change.
#
# Every other status is a fair tip. Do NOT special-case them individually: a
# task's code is buildable-on the moment it is implemented, `jt done` does not
# strip (so a finished task keeps its trailers until `jt strip`), and a LANDED
# task is routinely flipped back to `todo` to carry follow-up feedback. An
# allowlist misses one of those and silently reintroduces the skip.
#
# EMPTY commits are excluded whatever they are — jj's scratch working copy, and
# equally a `jt new` task placeholder that is filed but not yet implemented.
# Skipping them is always safe, and for the same reason the denylist above is
# minimal: an empty commit contributes no content, so passing it over drops
# nothing, whereas passing over a non-empty one would. Basing real work on a
# placeholder would otherwise bury an unimplemented task mid-stack and invent a
# dependency that was never intended. If everything is excluded (fresh repo, @
# on root), fall back to @ so callers always get a revision.
worktip() {
  local tip
  tip=$(jj log -r "heads(::@ ~ description(substring:\"Task-Status: doing\") ~ empty())" \
    --no-graph --ignore-working-copy -T 'change_id.shortest(8)' | head -n1)
  [[ -z "$tip" ]] && tip=$(jj log -r @ --no-graph --ignore-working-copy -T 'change_id.shortest(8)')
  printf '%s' "$tip"
}

# Resolve a revision to exactly one task id.
#
# The argument is a REVSET — jj does the prefix resolution, and reports an
# ambiguous prefix in its own words; intersecting with $TASKS is what makes
# "resolves, but isn't a task" an error. There is deliberately no matching
# against summary text: that made a short prefix (all `change_id.shortest()`
# ever yields, so what jjui passes) substring-hit half the board and silently
# resolve to the wrong task.
resolve() {
  local q="$1" out
  out=$(jj log -r "($TASKS) & ($q)" --no-graph --ignore-working-copy \
          -T 'change_id.shortest(8) ++ "\n"' 2>&1) || die "$out"
  [[ -z "$out" ]] && die "no task matches '$q'"
  [[ $(wc -l <<<"$out") -gt 1 ]] && die "'$q' is ambiguous:"$'\n'"$out"
  printf '%s' "$out"
}

desc_of() { jj log -r "$1" --no-graph --ignore-working-copy -T 'description'; }

# ------------------------------------------------------------------- commands

cmd_list() {
  local all=0 tree=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -a|--all)  all=1; shift ;;
      -t|--tree) tree=1; shift ;;
      *) die "usage: jt list [-a] [-t]" ;;
    esac
  done
  # Tree view: jj draws the graph, so ordering is structural (blockers below
  # dependents) rather than by priority — that's the trade for seeing the DAG.
  if [[ $tree -eq 1 ]]; then
    jj log -r "$(ui_revset)" --ignore-working-copy \
       --config ui.log-synthetic-elided-nodes=false -T "$(task_template)"
    return
  fi
  raw | awk -F'\t' -v all="$all" -v c_id="$c_id" -v c_todo="$c_todo" -v c_doing="$c_doing" \
            -v c_blocked="$c_blocked" -v c_done="$c_done" -v c_inv="$c_inv" \
            -v c_prio="$c_prio" -v c_needs="$c_needs" -v c_off="$c_off" \
            -v c_testing="$c_testing" -v c_defer="$c_defer" \
    "$AWKLIB"'
    {
      id = $1; par = $2
      d = unesc(substr($0, index($0, "\"")))
      delete L; delete T; delete O
      if (parse(d, L, T, O) == 0) next          # has the substring but no trailer block
      if (!("task-status" in T)) next
      n++; ID[n] = id; PAR[n] = par
      ST[id] = T["task-status"]; PR[id] = T["priority"]; SUM[id] = L[1]
    }
    END {
      # Priority order, preserving graph order within a priority. Graph order
      # alone is unstable: rewriting a task bumps its commit time.
      for (i = 1; i <= n; i++) { p = PR[ID[i]]; PSET[(p == "" ? "~" : p)] = 1 }
      m = asorti(PSET, PKEY)
      for (k = 1; k <= m; k++) for (i = 1; i <= n; i++) {
        id = ID[i]
        p = PR[id]; if (p == "") p = "~"
        if (p != PKEY[k]) continue
        if (!all && ST[id] == "done") continue
        needs = ""
        split(PAR[i], ps, " ")
        for (j in ps) if (ps[j] in ST && ST[ps[j]] != "done" && ST[ps[j]] != "testing")
          needs = needs (needs ? " " : "") ps[j]
        col = ST[id] == "doing" ? c_doing : ST[id] == "blocked" ? c_blocked : \
              ST[id] == "done" ? c_done : ST[id] == "investigating" ? c_inv : \
              ST[id] == "testing" ? c_testing : ST[id] == "deferred" ? c_defer : c_todo
        line = c_id id c_off " " col "[" ST[id] "]" c_off
        if (PR[id]) line = line " " c_prio "(" PR[id] ")" c_off
        line = line " " (ST[id] == "done" ? c_done SUM[id] c_off : SUM[id])
        if (needs) line = line " " c_needs "(needs " needs ")" c_off
        print line; shown++
      }
      if (!shown) print "no open tasks"
    }'
}

# -q drops `body`. Not cosmetic: on a ~30-task board the bodies are 90% of the
# output (99KB vs 11KB measured), and an orchestrator that polls the board every
# loop iteration pays that repeatedly, in context, for tasks it isn't running.
# Poll with -q; read one task's body with `jt show <id>` when you dispatch it.
cmd_json() {
  local all=0 brief=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -a|--all)   all=1; shift ;;
      -q|--brief) brief=1; shift ;;
      *) die "usage: jt json [-a] [-q]" ;;
    esac
  done
  raw | awk -F'\t' -v all="$all" -v brief="$brief" "$AWKLIB"'
    {
      id = $1; par = $2; empty = $3
      d = unesc(substr($0, index($0, "\"")))
      delete L; delete T; delete O
      start = parse(d, L, T, O)
      if (start == 0 || !("task-status" in T)) next
      n++; ID[n] = id; PAR[n] = par; EM[id] = empty
      ST[id] = T["task-status"]; PR[id] = T["priority"]
      SC[id] = T["scope"]; SUM[id] = L[1]
      last = start - 1
      while (last > 0 && L[last] ~ /^[ \t]*$/) last--
      s = 2; while (s <= last && L[s] ~ /^[ \t]*$/) s++
      b = ""
      for (i = s; i <= last; i++) b = b (i > s ? "\n" : "") L[i]
      BODY[id] = b
    }
    END {
      for (i = 1; i <= n; i++) {
        id = ID[i]
        if (!all && ST[id] == "done") continue
        needs = ""
        split(PAR[i], ps, " ")
        for (j in ps) if (ps[j] in ST && ST[ps[j]] != "done" && ST[ps[j]] != "testing")
          needs = needs (needs ? " " : "") ps[j]
        ready = (needs == "" && (ST[id] == "todo" || ST[id] == "ready")) ? "true" : "false"
        printf "{\"id\":\"%s\",\"status\":\"%s\",\"priority\":\"%s\",\"scope\":\"%s\"," \
               "\"summary\":\"%s\",\"needs\":\"%s\",\"ready\":%s,\"empty\":%s", \
               id, jesc(ST[id]), jesc(PR[id]), jesc(SC[id]), jesc(SUM[id]), needs, \
               ready, (EM[id] == "1" ? "true" : "false")
        if (!brief) printf ",\"body\":\"%s\"", jesc(BODY[id])
        printf "}\n"
      }
    }'
}

cmd_show() {
  local id; id=$(resolve "${1:?usage: jt show <id>}")
  printf '%s%s%s\n\n' "$c_id" "$id" "$c_off"
  desc_of "$id"
}

# Rewrite the trailer block. Args: id key=val...
cmd_set() {
  local id; id=$(resolve "${1:?usage: jt set <id> key=val...}"); shift
  [[ $# -eq 0 ]] && die "nothing to set"
  local kvs=() have_body=0 newbody=""
  for kv in "$@"; do
    [[ "$kv" != *=* ]] && die "expected key=value, got '$kv'"
    local k="${kv%%=*}" v="${kv#*=}"
    case "${k,,}" in
      status|task-status) k="Task-Status"
        [[ " $STATUSES " == *" $v "* ]] || die "status must be one of: $STATUSES" ;;
      priority|prio) k="Priority" ;;
      scope) k="Scope" ;;
      # body= replaces the description body, not a trailer. It's handled
      # out-of-band (via a dedicated awk -v) because the trailer path joins
      # all key=value pairs with newlines before splitting on them — a
      # multi-line body value would get sliced into bogus trailer lines and
      # corrupt the real ones.
      body) have_body=1
        if [[ "$v" == "-" ]]; then newbody="$(cat)"; else newbody="$v"; fi
        continue ;;
    esac
    kvs+=("$k=$v")
  done
  desc_of "$id" | awk -v kvspec="$(printf '%s\n' "${kvs[@]}")" \
      -v have_body="$have_body" -v newbody="$newbody" "$AWKLIB"'
    { d = d (NR > 1 ? "\n" : "") $0 }
    END {
      start = parse(d, L, T, O)
      if (start == 0) { body = d; O[0] = 0 } else body = body_of(L, start)
      if (have_body == "1") body = newbody
      nk = split(kvspec, KV, "\n")
      for (i = 1; i <= nk; i++) {
        if (KV[i] == "") continue
        p = index(KV[i], "="); k = substr(KV[i], 1, p-1); v = substr(KV[i], p+1)
        if (!(tolower(k) in T)) { O[0]++; O[O[0]] = k }
        T[tolower(k)] = v
        CASE[tolower(k)] = k
      }
      printf "%s\n\n", body
      seen["task-status"] = seen["priority"] = seen["scope"] = 0
      for (i = 1; i <= O[0]; i++) {
        lk = tolower(O[i]); if (done_[lk]++) continue
        if (T[lk] == "") continue
        k = (lk in CASE) ? CASE[lk] : O[i]
        printf "%s: %s\n", k, T[lk]
      }
    }' | jj describe "$id" --stdin "${JJ_IGNORE_IMMUTABLE[@]}" --quiet
  printf 'jt: %s updated\n' "$id"
}

cmd_new() {
  local summary="" prio="" scope="" parents=() body=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--priority) prio="$2"; shift 2 ;;
      -s|--scope)    scope="$2"; shift 2 ;;
      -b|--blocked-by) parents+=("$(resolve "$2")"); shift 2 ;;
      --parent)      parents+=("$2"); shift 2 ;;
      --body)        body="$2"; shift 2 ;;
      -*) die "unknown flag $1" ;;
      *) summary="${summary:+$summary }$1"; shift ;;
    esac
  done
  [[ -z "$summary" ]] && die "usage: jt new <summary> [-p P1] [-s scope] [-b blocker]"
  [[ ${#parents[@]} -eq 0 ]] && parents=("$(worktip)")
  local trailers="Task-Status: todo"
  [[ -n "$prio"  ]] && trailers="$trailers"$'\n'"Priority: $prio"
  [[ -n "$scope" ]] && trailers="$trailers"$'\n'"Scope: $scope"
  local args=(new "${parents[@]}" --no-edit -m "$summary")
  [[ -n "$body" ]] && args+=(-m "$body")
  args+=(-m "$trailers")
  local out id
  out=$(jj "${args[@]}" 2>&1)
  id=$(grep -oE 'Created new commit [a-z]+' <<<"$out" | head -n1 | awk '{print $4}')
  [[ -z "$id" ]] && { printf '%s\n' "$out" >&2; die "could not determine new task id"; }
  printf '%s%s%s %s\n' "$c_id" "$id" "$c_off" "$summary"
}

cmd_start() {
  local id; id=$(resolve "${1:?usage: jt start <id>}")
  local tip; tip=$(worktip)
  local cur; cur=$(jj log -r "$id-" --no-graph --ignore-working-copy -T 'change_id.shortest(8)' | head -n1)
  # NEVER rebase a task that is already an ANCESTOR of the tip. A task whose
  # work landed earlier and is now being reopened (a `testing` task above all —
  # `worktip` counts those as tip candidates, so a reopened one is routinely
  # buried mid-stack) sits UNDER commits that were built on top of it. Moving it
  # to the top tears it out of the middle: every descendant that touched the
  # same lines has to re-apply without it, which conflicts the entire stack
  # above it — 18 landed commits, in the case that prompted this guard. Leave it
  # where it sits and let the work continue in place; `jj edit` below still puts
  # the caller on it.
  local buried; buried=$(jj log -r "($id) & (::($tip))" --no-graph --ignore-working-copy \
                           -T 'change_id.shortest(8)' 2>/dev/null | head -n1)
  if [[ -n "$buried" ]]; then
    printf 'jt: %s is already an ancestor of %s — working it in place (no rebase)\n' "$id" "$tip"
  elif [[ "$cur" != "$tip" && "$id" != "$tip" ]]; then
    if jj rebase -r "$id" -d "$tip" "${JJ_IGNORE_IMMUTABLE[@]}" --quiet 2>/dev/null; then
      printf 'jt: rebased %s onto %s\n' "$id" "$tip"
    else
      printf 'jt: could not rebase onto %s — working it where it sits\n' "$tip" >&2
    fi
  fi
  cmd_set "$id" status=doing >/dev/null
  jj edit "$id" "${JJ_IGNORE_IMMUTABLE[@]}" --quiet
  printf 'jt: %s is now @ (status doing)\n' "$id"
}

cmd_done() {
  local id; id=$(resolve "${1:?usage: jt done <id>}")
  local empty; empty=$(jj log -r "$id" --no-graph --ignore-working-copy -T 'if(empty,"1","0")')
  [[ "$empty" == "1" ]] && printf 'jt: warning — %s is empty (no code changes)\n' "$id" >&2
  cmd_set "$id" status=done >/dev/null
  printf 'jt: %s marked done — off the default board; `jt strip` finishes it\n' "$id"
}

# The trailer-stripping half of the old `jt done`. Split out so a task can sit
# at status=done (visible with -a, filterable, still on the graph) for as long
# as it takes to clean up the commit message, rather than losing its trailers
# the instant it's marked complete.
cmd_strip() {
  local id; id=$(resolve "${1:?usage: jt strip <id>}")
  desc_of "$id" | awk "$AWKLIB"'
    { d = d (NR > 1 ? "\n" : "") $0 }
    END {
      start = parse(d, L, T, O)
      if (start == 0) { printf "%s\n", d; exit }
      body = body_of(L, start)
      keep = ""
      for (i = 1; i <= O[0]; i++) {
        lk = tolower(O[i])
        if (lk == "task-status" || lk == "priority" || lk == "scope") continue
        if (done_[lk]++) continue
        keep = keep sprintf("%s: %s\n", O[i], T[lk])
      }
      printf "%s\n", body
      if (keep != "") printf "\n%s", keep
    }' | jj describe "$id" --stdin "${JJ_IGNORE_IMMUTABLE[@]}" --quiet
  printf 'jt: %s stripped — trailers gone, off the board for good\n' "$id"
}

cmd_block() {
  local id; id=$(resolve "${1:?usage: jt block <id> [reason]}"); shift
  local reason="${*:-}"
  if [[ -n "$reason" ]]; then
    desc_of "$id" | awk -v r="$reason" "$AWKLIB"'
      { d = d (NR > 1 ? "\n" : "") $0 }
      END {
        start = parse(d, L, T, O)
        body = (start == 0) ? d : body_of(L, start)
        printf "%s\n\nBLOCKED: %s\n", body, r
        if (start != 0) { printf "\n"
          for (i = 1; i <= O[0]; i++) { lk = tolower(O[i])
            if (done_[lk]++) continue
            printf "%s: %s\n", O[i], (lk == "task-status" ? "blocked" : T[lk]) } }
      }' | jj describe "$id" --stdin "${JJ_IGNORE_IMMUTABLE[@]}" --quiet
    printf 'jt: %s blocked\n' "$id"
  else
    cmd_set "$id" status=blocked
  fi
}

cmd_defer() {
  local id; id=$(resolve "${1:?usage: jt defer <id> [reason]}"); shift
  local reason="${*:-}"
  if [[ -n "$reason" ]]; then
    desc_of "$id" | awk -v r="$reason" "$AWKLIB"'
      { d = d (NR > 1 ? "\n" : "") $0 }
      END {
        start = parse(d, L, T, O)
        body = (start == 0) ? d : body_of(L, start)
        printf "%s\n\nDEFERRED: %s\n", body, r
        if (start != 0) { printf "\n"
          for (i = 1; i <= O[0]; i++) { lk = tolower(O[i])
            if (done_[lk]++) continue
            printf "%s: %s\n", O[i], (lk == "task-status" ? "deferred" : T[lk]) } }
      }' | jj describe "$id" --stdin "${JJ_IGNORE_IMMUTABLE[@]}" --quiet
    printf 'jt: %s deferred\n' "$id"
  else
    cmd_set "$id" status=deferred
  fi
}

cmd_tip() { worktip; echo; }

# Launch jjui on the task graph. Including parents($TASKS) connects the tasks
# into one component: jj draws a trailing "~" per *disconnected* component, so
# without it you get one per task (6 vs 1 on a real board). It also shows what
# the tasks are based on, and renders blocker edges properly.
cmd_ui() {
  command -v jjui >/dev/null 2>&1 || die "jjui is not installed"
  exec jjui -r "$(ui_revset)" "$@"
}

# A task's evolution trail. The old template-based version could only word-diff
# the raw description; parsing outside jj lets this report what actually
# changed — status transitions, priority, checklist progress — and needs no
# external diff tool.
cmd_evo() {
  local q="${1:?usage: jt evo <id>}" id
  id=$(resolve "$q" 2>/dev/null) || id="$q"
  jj log -r "$id" --no-graph --ignore-working-copy -T '""' >/dev/null 2>&1 \
    || die "no such revision '$q'"
  printf '%s%s%s %s\n\n' "$c_id" "$(jj log -r "$id" --no-graph --ignore-working-copy \
    -T 'change_id.shortest(8)')" "$c_off" \
    "$(jj log -r "$id" --no-graph --ignore-working-copy -T 'description.first_line()')"

  jj evolog -r "$id" --reversed --no-graph --ignore-working-copy -T \
    'commit.commit_id().short(8) ++ "\t" ++ commit.committer().timestamp().local().format("%Y-%m-%d %H:%M") ++ "\t" ++ if(commit.empty(),"1","0") ++ "\t" ++ json(commit.description()) ++ "\n"' \
  | awk -F'\t' -v c_id="$c_id" -v c_off="$c_off" -v c_add="$c_doing" -v c_del="$c_blocked" \
        -v c_meta="$c_prio" -v c_dim="$c_done" "$AWKLIB"'
    function ckdone(s,   n, t) { t = s; n = gsub(/- \[[xX]\]/, "", t); return n }
    function cktodo(s,   n, t) { t = s; n = gsub(/- \[ \]/, "", t); return n }
    {
      cid = $1; ts = $2; em = $3
      d = unesc(substr($0, index($0, "\"")))
      key = d; sub(/[ \t\n]+$/, "", key)
      if (n > 0 && key == PKEY) { CID[n] = cid; TS[n] = ts; EM[n] = em; next }
      n++; CID[n] = cid; TS[n] = ts; EM[n] = em; D[n] = d; PKEY = key
    }
    END {
      for (i = 1; i <= n; i++) {
        delete L; delete T; delete O
        start = parse(D[i], L, T, O)
        body = (start == 0) ? D[i] : body_of(L, start)
        printf "  %s%s%s  %s%s\n", c_dim, TS[i], c_off, CID[i], \
               (EM[i] == "1" ? "  " c_dim "(empty)" c_off : "")
        delete CASE
        for (j = 1; j <= O[0]; j++) CASE[tolower(O[j])] = O[j]
        if (i == 1) {
          nl = split(D[i], FL, "\n")
          for (j = 1; j <= nl; j++) {
            if (j == nl && FL[j] == "") continue
            printf "      %s\n", FL[j]
          }
          printf "\n"; PB = body; delete PT; delete PCASE
          for (k in T) PT[k] = T[k]
          for (k in CASE) PCASE[k] = CASE[k]
          continue
        }
        # trailer transitions — the signal the old word-diff buried in prose
        for (k in T) if (!(k in PT)) printf "      %s+ %s: %s%s\n", c_meta, CASE[k], T[k], c_off
          else if (T[k] != PT[k]) printf "      %s%s: %s → %s%s\n", c_meta, CASE[k], PT[k], T[k], c_off
        for (k in PT) if (!(k in T)) printf "      %s- %s (dropped)%s\n", c_meta, PCASE[k], c_off
        pd = ckdone(PB); pt = cktodo(PB); cd = ckdone(body); ct = cktodo(body)
        if (pd + pt > 0 || cd + ct > 0) if (pd != cd || pt != ct)
          printf "      %schecklist: %d/%d → %d/%d%s\n", c_meta, pd, pd+pt, cd, cd+ct, c_off
        # body line delta
        delete PC; delete CC
        np = split(PB, PL, "\n"); nc = split(body, CL, "\n")
        for (j = 1; j <= np; j++) PC[PL[j]]++
        for (j = 1; j <= nc; j++) CC[CL[j]]++
        for (j = 1; j <= np; j++) if (PL[j] != "" && CC[PL[j]] < PC[PL[j]]) {
          printf "      %s- %s%s\n", c_del, PL[j], c_off; PC[PL[j]]-- }
        for (j = 1; j <= nc; j++) if (CL[j] != "" && PC[CL[j]] <= 0) {
          printf "      %s+ %s%s\n", c_add, CL[j], c_off } else if (CL[j] != "") PC[CL[j]]--
        printf "\n"
        PB = body; delete PT; delete PCASE
        for (k in T) PT[k] = T[k]
        for (k in CASE) PCASE[k] = CASE[k]
      }
    }'
  local stat
  stat=$(jj diff -r "$id" --stat --ignore-working-copy 2>/dev/null || true)
  if [[ -n "$stat" && "$stat" != "0 files changed"* ]]; then
    printf '  %s── task diff ──%s\n' "$c_prio" "$c_off"
    sed 's/^/  /' <<<"$stat"
  fi
}

# ------------------------------------------------------------------- grind
# Run batches of tasks unattended, one fresh `claude -p` per batch.
#
# The point is the process boundary: a slash command cannot clear its own
# context, so a long unattended run inside one session pays for every earlier
# batch's transcript on every later turn. One process per batch starts each
# batch at zero. /jt:burst already picks its batch up front and refuses to
# re-query mid-run ("next run's problem") — that clause is exactly what makes
# it composable under an outer loop.
#
# The loop is deliberately dumb: it decides only *whether* another batch should
# run, from `jt json` — which costs no context at all.

grind_ready() { jt json -q | jq -s '[.[] | select(.ready)] | length'; }
grind_doing()  { jt json -q | jq -sr '.[] | select(.status == "doing") | .id'; }
grind_hash()   { jt json -q -a | jq -sr '[.[] | .id + ":" + .status] | sort | join(",")' | cksum; }

cmd_grind() {
  local rounds=10 dir="" model="" budget="" focus="" logdir="" dry=0 here=0
  local cmd="/jt:burst"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--rounds)  rounds="$2"; shift 2 ;;
      -C|--dir)     dir="$2"; shift 2 ;;
      --model)      model="$2"; shift 2 ;;
      --budget)     budget="$2"; shift 2 ;;
      --command)    cmd="$2"; shift 2 ;;
      --log)        logdir="$2"; shift 2 ;;
      --here)       here=1; shift ;;
      -n|--dry-run) dry=1; shift ;;
      -h|--help)    grind_usage; return 0 ;;
      --)           shift; focus="$*"; break ;;
      -*)           die "unknown flag '$1' (try: jt grind --help)" ;;
      *)            focus="$*"; break ;;
    esac
  done
  command -v claude >/dev/null 2>&1 || die "claude is not on PATH"
  command -v jq >/dev/null 2>&1 || die "jq is not installed (jt grind needs it)"

  [[ -n "$dir" ]] && { cd "$dir" || die "no such directory: $dir"; }
  local root; root=$(jj workspace root 2>/dev/null) || die "not in a jj workspace"
  cd "$root"
  # A secondary workspace stores .jj/repo as a *file* pointing at the store;
  # the default workspace has it as a directory. Grinding in the default
  # workspace means `jt start`'s `jj edit` seizes the @ the user works from.
  if [[ -d .jj/repo && $here -eq 0 ]]; then
    die "refusing to grind in the default workspace ($root) — \`jt start\` would
    seize the @ you work from. Point it at another workspace with -C <path>
    (\`jj workspace list\`), or pass --here if you really mean this one."
  fi

  logdir="${logdir:-${XDG_STATE_HOME:-$HOME/.local/state}/jt/grind}"
  local stamp; stamp=$(date +%Y%m%d-%H%M%S)

  local -a claude_args=(-p --output-format json --permission-mode bypassPermissions)
  # Deploying is the user's call, always — never a side effect of an
  # unattended run. Everything else is fair game inside a workspace.
  claude_args+=(--disallowedTools "Bash(just deploy:*)")
  [[ -n "$model" ]]  && claude_args+=(--model "$model")
  [[ -n "$budget" ]] && claude_args+=(--max-budget-usd "$budget")
  local prompt="$cmd"; [[ -n "$focus" ]] && prompt="$cmd $focus"

  if [[ $dry -eq 1 ]]; then
    printf 'workspace: %s\nrounds:    %s\nlogs:      %s/%s-r<N>.json\nper round: claude %s %s\n' \
      "$root" "$rounds" "$logdir" "$stamp" "${claude_args[*]}" "$prompt"
    printf 'ready now: %s\n' "$(grind_ready)"
    return 0
  fi
  mkdir -p "$logdir"

  local round=1 ran=0 total=0 lasthash="" stall=0 leaked="" ready
  while (( round <= rounds )); do
    ready=$(grind_ready)
    if (( ready == 0 )); then
      printf 'jt grind: nothing ready — stopping after %d round(s)\n' "$((round - 1))"
      jt list | grep -E '\[(blocked|testing)\]' || true
      break
    fi
    printf '── round %d/%d — %d ready — %s\n' "$round" "$rounds" "$ready" "$(date +%H:%M)"
    local log="$logdir/$stamp-r$round.json" rc=0
    claude "${claude_args[@]}" "$prompt" >"$log" 2>&1 || rc=$?
    if (( rc != 0 )); then
      printf 'jt grind: claude exited %d — stopping (log: %s)\n' "$rc" "$log"
      break
    fi
    ran=$((ran + 1))   # not (( ran++ )): under set -e a post-increment from 0
                       # evaluates to 0 and kills the loop
    local cost; cost=$(jq -r '.total_cost_usd // 0' "$log" 2>/dev/null || echo 0)
    total=$(awk -v a="$total" -v b="$cost" 'BEGIN{printf "%.4f", a + b}')
    printf '   done — $%s (run total $%s) — %s\n' "$cost" "$total" "$log"
    jq -r '.result // empty' "$log" 2>/dev/null | head -20 | sed 's/^/   /'

    # A task left `doing` means the worker misfired (verify failed, or it never
    # closed out). It is no longer ready, so it would silently drop out of the
    # pool and the loop would declare victory with work half-claimed. Reset it
    # once; a second leak of the same task is a real stop.
    local id
    for id in $(grind_doing); do
      if [[ " $leaked " == *" $id "* ]]; then
        printf 'jt grind: %s left `doing` twice — stopping, it needs a look\n' "$id"
        return 1
      fi
      leaked="$leaked $id"
      jt set "$id" status=todo >/dev/null
      printf '   reset %s doing→todo (worker did not close it out)\n' "$id"
    done

    local h; h=$(grind_hash)
    if [[ "$h" == "$lasthash" ]]; then
      (( ++stall >= 2 )) && { printf 'jt grind: board unchanged for 2 rounds — stopping\n'; break; }
    else
      stall=0
    fi
    lasthash="$h"
    round=$((round + 1))
  done
  (( round > rounds )) && printf 'jt grind: hit the %d-round cap\n' "$rounds"
  printf 'jt grind: spent $%s across %d round(s); tip %s\n' "$total" "$ran" "$(worktip)"
}

grind_usage() {
  cat <<'EOF'
jt grind [options] [focus] — run batches of tasks unattended.

Each round is a fresh `claude -p` process running a slash command (default
/jt:burst), so context starts at zero every batch. Between rounds only `jt
json` is consulted, which costs no context.

  -r, --rounds N     max batches (default 10)
  -C, --dir PATH     workspace to run in (default: cwd's workspace)
      --model M      model for each batch (e.g. sonnet)
      --budget USD   per-round spend cap
      --command CMD  slash command per round (default /jt:burst)
      --log DIR      log dir (default $XDG_STATE_HOME/jt/grind)
      --here         allow running in the default workspace
  -n, --dry-run      show what would run

Stops when nothing is ready, the round cap is hit, the board stops changing,
claude exits nonzero, or a task is left `doing` twice.
EOF
}

# ------------------------------------------------- Claude Code slash commands
# Embedded so the script is the single source of truth: `jt install` writes them
# to ~/.claude/commands/jt/, giving /jt:file /jt:board /jt:start /jt:burst
# /jt:decide. They drive jt rather than raw jj revsets, so they don't break when
# the revset wiring changes.

md_file() { cat <<'JTMD'
---
description: File a feature request or bug report as a jj task
argument-hint: [what's broken / what you want]
allowed-tools: Bash(jt:*), AskUserQuestion
---

## Open board

!`jt list`

## Request

$ARGUMENTS

## Your task

File the request above as **one** task. Do not write code, do not start the
work, do not investigate beyond a quick look to scope it.

1. **Dedupe.** If it's already on the board, say which task and stop. If it
   refines an existing task, update that one instead of filing a
   near-duplicate: `jt show <id>` for its current body, then `jt set <id>
   body=-` (feed the merged detail via stdin — preserves the status/priority/
   scope trailers, and stdin is the safe way to send a multi-line body).

2. **Create it:**
   ```
   jt new "<one-line summary>" -p P2 -s "path/a, path/b" --body "<detail>"
   ```
   `jt new` parents the task on the current work tip, so its provenance pins the
   code state it was filed against. You don't need to pick a parent.

   - `-p` — P0..P3. Calibrate against the priorities already on the board.
   - `-s` — files you'd expect to touch. This is what stops a later burst run
     colliding with in-flight work. Approximate is fine; omit only if you
     genuinely can't guess.
   - `--body` — for a bug: reproduction, observed vs expected. For a feature:
     what and why, not how.

3. **Blocked by something?** `jt new "…" -b <blocker-id>` makes it a real
   dependency edge — it shows as `(needs <id>)` and won't count as ready.

4. **Ask at most one question**, via `AskUserQuestion`, and only if you can't
   assign priority or scope without it. A vague task filed now beats an
   interrogation.

Report the change id and summary. Nothing else.
JTMD
}

md_board() { cat <<'JTMD'
---
description: Show the task board and lane state
argument-hint: [optional filter, e.g. "P1" or "auth"]
allowed-tools: Bash(jt:*), Bash(jj workspace:*)
---

## Board

!`jt list`

## Structured

!`jt json -q`

## Workspaces

!`jj workspace list`

## Your task

Read-only. Change nothing.

Summarise the board at a glance:

- **Ready** — `"ready":true` in the JSON (no unfinished blockers, status todo or
  ready). Highest priority first.
- **In flight** — status `doing`. Another session owns these; name each and its
  scope.
- **Collisions** — any ready task whose `scope` overlaps something `doing`.
  Those must wait; picking one up means a merge conflict later.
- **Testing** — status `testing`. Implementation is done and waiting on me to
  confirm; name each and what it's waiting on me to check.
- **Blocked** — phrase each as the actual question waiting on me, not the title.
- **Deferred** — one trailing line, count and ids only. They're shelved on
  purpose; don't expand them into the glance.

Filter to `$ARGUMENTS` if given. Be terse — this is a glance, not a report. End
with the one task you'd pick up next, and why.
JTMD
}

md_start() { cat <<'JTMD'
---
description: Work one task with me in the loop on the design
argument-hint: [task id]
allowed-tools: Bash(jt:*), Bash(jj:*), AskUserQuestion
---

## Board

!`jt list`

## Which task

$ARGUMENTS

## Your task

Work **one** task, with me involved in the design. This is the attended mode —
the point is that I see and can redirect the approach before code exists. If I
wanted it done unsupervised I'd have said `/jt:burst`.

### Set up

`jt start <id>` — takes a change-id prefix (ids only; there is no text search). It
claims the task as `doing`, rebases it onto the current work tip so you build on
current code rather than the state it was filed against, and makes it the
working copy. If it reports that it couldn't rebase, tell me before continuing.

### Then stop

Investigate the code and come back to me with:

- what you found, and whether the task's premise still holds
- the approach you'd take, in a few sentences
- **any fork worth my input** — the options and your recommendation
- anything in the task description that turned out to be wrong

**Write no code until I've responded.** If the description already settles the
design and you genuinely have nothing to ask, say so in a line and start — but
the default is to check.

Use `AskUserQuestion` for a real fork with discrete options; plain prose when
you just want a sanity check.

### Then work it

- Keep a `- [ ]` / `- [x]` checklist in the task description, ticking items off
  as you go. `jt evo <id>` then shows the checklist filling in over time.
- Update the description at **checkpoints** — a decision taken, a blocker hit.
  Rewrite it to describe the current state, don't just append; a couple of
  short paragraphs at most, not a transcript. `jt set <id> body=-` (stdin)
  rewrites the body without disturbing the status/priority/scope trailers.
- New files: `jj file track <path>`. Auto-track is off, so an untracked file
  silently isn't in the commit.
- Notice something unrelated? `jt new "…"` and carry on. Don't scope-creep.
- Turns out much bigger than it looked? Say so and let me decide whether to
  split it, rather than quietly working for an hour.

### Finish

1. **Verify** — the project's verify command from `CLAUDE.md`. Exit 0 is the
   only thing that counts; ignore stale LSP diagnostics.
2. **`jj describe <id>`** — rewrite the description to a clean implementation
   summary: the change and its motivation, matching how the code actually
   ended up, not a log of the work or issues hit along the way. A couple of
   short paragraphs, max — preferably less.
3. **Needs eyes-on confirmation** (a UI/frontend change, anything the verify
   command can't actually judge)? `jt set <id> status=testing` instead of
   `jt done`, and say what to look at. The task stays on the board until I set
   it to `done` myself (or tell you to). Otherwise, **`jt done <id>`** — marks
   it done and drops it off the default board. It warns if the change is
   still empty; that warning means something went wrong, so stop and say so.
   Either way, the trailers stay put for now — `/jt:cleanup` tidies the
   message and strips them later, in a batch.
4. Report the change id, what you did, and anything you left for later.

Don't squash, rebase other changes, or move bookmarks — that's mine.
JTMD
}

md_burst() { cat <<'JTMD'
---
description: Knock out a run of small ready tasks, unattended
argument-hint: [optional focus, e.g. "the UI bugs" or a change id]
allowed-tools: Bash(jt:*), Bash(jj:*)
---

## Board

!`jt list`

## Structured

!`jt json -q`

## Focus

$ARGUMENTS

## Your task

Work a run of **small** ready tasks back to back, without checking in. This is
the unattended counterpart to `/jt:start` — don't ask me things, park them.

### Picking

**Select the whole batch before starting any work.** From the board above,
pick — in priority order, narrowed to `$ARGUMENTS` if given — tasks with
`"ready":true` whose `scope` doesn't overlap a task marked `doing` (another
session owns those files). Write that list down now; the run works exactly
that list, in that order. Don't re-query the board mid-run to fold in newly
ready or newly filed tasks — those are next run's problem, not this one.

**Cap the batch at 8 tasks.** If more than 8 qualify, take the top 8 by
priority and note the rest as left for next time — hitting the cap is a
normal stop, not a failure.

**Only small tasks.** If one needs real design or a wide diff, leave it out of
the batch, write what you learned into its description (`jt set <id>
body=-`, stdin so it stays safe with a multi-line body), leave it `todo`, and
move on. Big work wants `/jt:start` or an orchestrate run, not this.

### Per task

1. **`jt start <id>`** — claims it, rebases onto the current work tip, makes it
   the working copy. For the second and later tasks in the run, the tip is the
   one you just finished, so the run accumulates as a clean line. Then **`jt
   show <id>`** for its full description — the board above is deliberately
   body-less (`-q`), so read the one body you need, when you need it, rather
   than carrying every task's body through the whole run. If the body reveals
   it's bigger than the summary looked, write what you learned into it
   (`jt set <id> body=-`) and **`jt set <id> status=todo`** before moving on:
   you have already claimed it, and a task left `doing` is invisible to the
   next run.
2. Do the work inline. Don't delegate — spin-up costs more than the fix at this
   size.
3. **`jj file track <path>`** for new files.
4. **Verify** — the project's command from `CLAUDE.md`. Exit 0 or it isn't done.
   Don't let raw stdout/stderr sit in context — report pass/fail, and on
   failure keep only the relevant error/tail, not the full log.
5. **`jj describe <id>`** to a clean summary — the change and why, matching
   the code as it ended up, not a log of the work; a couple of short
   paragraphs, max. Needs my eyes-on before it's really done (a UI change,
   anything verify can't judge)? `jt set <id> status=testing` and note what to
   check — that's finished for this run, the next task still builds on top of
   it. Otherwise **`jt done <id>`** — marks it done; trailers stay put until a
   later `/jt:cleanup` batch strips them.

### Along the way

- **Design fork?** `jt block <id> "<the question, with options and your
  recommendation>"` and move to the next task. Never guess, never stall the run
  — I'll drain them with `/jt:decide`.
- **Spot something new?** `jt new "…"` and keep going. Don't scope-creep.
- **Broken tree** is top priority — fix it before starting anything else.
- Keep descriptions terse: the decision and why, not a play-by-play.
- Tasks marked `deferred` are shelved on purpose — never `jt start` one, even
  if it looks small and ready.

Don't squash, merge, or move bookmarks — history cleanup is mine.

Stop when the batch is done, nothing was ready to select, or I interrupt.
Report one line per task (change id + what you did), anything blocked or
skipped, any qualifying tasks left over past the cap, and the final tip.
JTMD
}

md_decide() { cat <<'JTMD'
---
description: Drain blocked tasks — answer the design forks waiting on me
argument-hint: [optional task id to decide just one]
allowed-tools: Bash(jt:*), AskUserQuestion
---

## Blocked tasks, in full

!`jt json | grep '"status":"blocked"'`

## Board for context

!`jt list`

## Scope

$ARGUMENTS

## Your task

These are the design forks that workers parked rather than guessing at. Walk me
through them and record what I decide. **That is the only thing you're doing** —
no code, no starting tasks.

For each blocked task (or just the one named in `$ARGUMENTS`):

1. **Put the fork to me with `AskUserQuestion`.** Use the options the task
   already lists in its `body`. Lead with the worker's recommendation if it made
   one, marked `(Recommended)`. Make option descriptions concrete about the
   trade-off — I should be able to decide from the question alone.

   If the task is vague about what's actually being asked, say so and ask the
   real question rather than a reconstructed one.

2. **Record the decision** — `jt set <id> body=-` (stdin; keeps the
   status/priority/scope trailers intact): state what was decided, why, and
   the date, and **replace the open question** rather than leaving both. A
   couple of sentences, not the debate. A future reader should see the
   resolution, not the history. `jt evo <id>` keeps
   the original either way.

3. **Unblock it** — `jt set <id> status=todo`. If my answer makes the task moot,
   `jt done <id>` (drops it off the default board; `/jt:cleanup` strips it for
   good later) and say you've done that. If I'd rather not decide now,
   `jt defer <id> "<why, so a later pass has context>"`
   — it drops off `/jt:decide`'s list and won't be raised again until I set it
   back to `todo` myself.

4. **Cascade.** If the decision settles a question another blocked task was also
   waiting on, resolve that one too and tell me — don't ask me twice.

Batch related forks into a single `AskUserQuestion` where they're genuinely one
decision; ask separately when they're not.

If nothing is blocked, say so in one line and stop.
JTMD
}

md_strip() { cat <<'JTMD'
---
description: Strip trailers off a task, leaving a clean commit
argument-hint: [task id]
allowed-tools: Bash(jt:*)
---

## Which task

$ARGUMENTS

## Your task

Purely mechanical — no code, no message rewrite, no judgment call. Resolve
`$ARGUMENTS` to a task and run `jt strip <id>`. It removes the Task-Status/
Priority/Scope trailers, leaving a clean commit that's off the board for good.

If `$ARGUMENTS` is empty or ambiguous, ask which task before running anything.
Report the change id.
JTMD
}

md_cleanup() { cat <<'JTMD'
---
description: Tidy commit messages for done tasks and strip their trailers
argument-hint: [optional filter, e.g. a task id or a word from its summary]
allowed-tools: Bash(jt:*), Bash(jj:*)
---

## Done tasks

!`jt json -a | grep '"status":"done"'`

## Scope

$ARGUMENTS

## Your task

Finish off every task listed above as `done` (or just the one matching
`$ARGUMENTS`, if given). These already got a real implementation and my
sign-off — this pass is bookkeeping, not review. For each:

1. **`jt show <id>`** for the full description.
2. **Rewrite the commit message** — a couple of short paragraphs, max,
   preferably less. State the change and its motivation where relevant,
   matching the code as it actually ended up — not a log of the work, dead
   ends, or issues hit along the way. Drop anything that isn't commit-worthy:
   the checklist, blocker notes, testing instructions. `jt set <id> body=-`
   (stdin) rewrites the body without touching the trailers.
3. **`jt strip <id>`** — removes the trailers and takes it off the board for
   good.

Don't skip a task because its message already looks fine — still strip it.
Don't squash, rebase other changes, or move bookmarks — that's mine.

Report one line per task: change id and the message it ended up with.
JTMD
}

# ------------------------------------------------------- shell completions
# Task ids are completed dynamically from `jt json -a`, with the summary as the
# description. Outside a jj repo that fails silently and you just get subcommands.

comp_zsh() { cat <<'JTEOF'
#compdef jt

_jt_ids() {
  local -a ids
  ids=(${(f)"$(jt json -a 2>/dev/null | sed -n 's/.*"id":"\([^"]*\)".*"summary":"\([^"]*\)".*/\1:\2/p')"})
  (( ${#ids} )) && _describe -t tasks 'task' ids
}

_jt() {
  local -a cmds
  cmds=(
    'list:board of open tasks'
    'board:board of open tasks'
    'json:board as JSONL'
    'new:file a task'
    'show:full description'
    'set:update trailers'
    'start:claim, rebase onto work tip, edit'
    'done:mark done, off the default board'
    'strip:strip trailers, leaves the board'
    'block:mark blocked, with a reason'
    'defer:mark deferred, with a reason'
    'evo:evolution trail'
    'tip:current work tip'
    'grind:run batches unattended, fresh context each'
    'install:write Claude commands + completions'
    'help:usage'
  )
  if (( CURRENT == 2 )); then
    _describe 'command' cmds
    return
  fi
  case "${words[2]}" in
    show|start|done|strip|evo)
      (( CURRENT == 3 )) && _jt_ids ;;
    block|defer)
      (( CURRENT == 3 )) && _jt_ids ;;
    set)
      if (( CURRENT == 3 )); then _jt_ids; else
        _values -S = 'field' \
          'status[task status]:status:(todo ready doing investigating blocked testing deferred done)' \
          'priority[priority]:priority:(P0 P1 P2 P3)' \
          'scope[files it touches]:scope:' \
          'body[description body, "-" for stdin]:body:'
      fi ;;
    list|board)
      _arguments '(-a --all)'{-a,--all}'[include done tasks]' ;;
    json)
      _arguments '(-a --all)'{-a,--all}'[include done tasks]' \
                 '(-q --brief)'{-q,--brief}'[drop bodies]' ;;
    new)
      _arguments \
        '(-p --priority)'{-p,--priority}'[priority]:priority:(P0 P1 P2 P3)' \
        '(-s --scope)'{-s,--scope}'[files it touches]:scope:' \
        '(-b --blocked-by)'{-b,--blocked-by}'[blocked by task]:task:_jt_ids' \
        '--parent[parent revision]:rev:' \
        '--body[body text]:text:' ;;
    grind)
      _arguments \
        '(-r --rounds)'{-r,--rounds}'[max batches]:rounds:' \
        '(-C --dir)'{-C,--dir}'[workspace to run in]:dir:_files -/' \
        '--model[model per batch]:model:(fable opus sonnet haiku)' \
        '--budget[per-round spend cap in USD]:usd:' \
        '--command[slash command per batch]:cmd:' \
        '--log[log dir]:dir:_files -/' \
        '--here[allow the default workspace]' \
        '(-n --dry-run)'{-n,--dry-run}'[show what would run]' ;;
    install)
      _arguments '--dir[Claude commands dir]:dir:_files -/' \
                 '(-n --dry-run)'{-n,--dry-run}'[show what would be written]' ;;
  esac
}

_jt "$@"
JTEOF
}

comp_fish() { cat <<'JTEOF'
function __jt_ids
    jt json -a 2>/dev/null | string replace -rf '.*"id":"([^"]*)".*"summary":"([^"]*)".*' '$1\t$2'
end

complete -c jt -f
complete -c jt -n __fish_use_subcommand -a list    -d 'board of open tasks'
complete -c jt -n __fish_use_subcommand -a json    -d 'board as JSONL'
complete -c jt -n __fish_use_subcommand -a new     -d 'file a task'
complete -c jt -n __fish_use_subcommand -a show    -d 'full description'
complete -c jt -n __fish_use_subcommand -a set     -d 'update trailers'
complete -c jt -n __fish_use_subcommand -a start   -d 'claim, rebase onto work tip, edit'
complete -c jt -n __fish_use_subcommand -a done    -d 'mark done, off the default board'
complete -c jt -n __fish_use_subcommand -a strip   -d 'strip trailers, leaves the board'
complete -c jt -n __fish_use_subcommand -a block   -d 'mark blocked, with a reason'
complete -c jt -n __fish_use_subcommand -a defer   -d 'mark deferred, with a reason'
complete -c jt -n __fish_use_subcommand -a evo     -d 'evolution trail'
complete -c jt -n __fish_use_subcommand -a tip     -d 'current work tip'
complete -c jt -n __fish_use_subcommand -a grind   -d 'run batches unattended, fresh context each'
complete -c jt -n __fish_use_subcommand -a install -d 'write Claude commands + completions'

complete -c jt -n '__fish_seen_subcommand_from show set start done strip block defer evo' -a '(__jt_ids)'
complete -c jt -n '__fish_seen_subcommand_from list json' -s a -l all -d 'include done tasks'
complete -c jt -n '__fish_seen_subcommand_from json' -s q -l brief -d 'drop bodies'
complete -c jt -n '__fish_seen_subcommand_from new' -s p -l priority -d 'priority' -x -a 'P0 P1 P2 P3'
complete -c jt -n '__fish_seen_subcommand_from new' -s s -l scope -d 'files it touches' -x
complete -c jt -n '__fish_seen_subcommand_from new' -s b -l blocked-by -d 'blocked by task' -x -a '(__jt_ids)'
complete -c jt -n '__fish_seen_subcommand_from new' -l body -d 'body text' -x
complete -c jt -n '__fish_seen_subcommand_from install' -l dir -d 'Claude commands dir' -x -a '(__fish_complete_directories)'
complete -c jt -n '__fish_seen_subcommand_from install' -s n -l dry-run -d 'show what would be written'
complete -c jt -n '__fish_seen_subcommand_from grind' -s r -l rounds -d 'max batches' -x
complete -c jt -n '__fish_seen_subcommand_from grind' -s C -l dir -d 'workspace to run in' -x -a '(__fish_complete_directories)'
complete -c jt -n '__fish_seen_subcommand_from grind' -l model -d 'model per batch' -x -a 'fable opus sonnet haiku'
complete -c jt -n '__fish_seen_subcommand_from grind' -l budget -d 'per-round spend cap (USD)' -x
complete -c jt -n '__fish_seen_subcommand_from grind' -l command -d 'slash command per batch' -x
complete -c jt -n '__fish_seen_subcommand_from grind' -l log -d 'log dir' -x -a '(__fish_complete_directories)'
complete -c jt -n '__fish_seen_subcommand_from grind' -l here -d 'allow the default workspace'
complete -c jt -n '__fish_seen_subcommand_from grind' -s n -l dry-run -d 'show what would run'
JTEOF
}

comp_bash() { cat <<'JTEOF'
_jt() {
  local cur prev cmds
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  cmds="list board json new show set start done strip block defer evo tip grind install help"

  if [[ $COMP_CWORD -eq 1 ]]; then
    mapfile -t COMPREPLY < <(compgen -W "$cmds" -- "$cur")
    return
  fi

  case "${COMP_WORDS[1]}" in
    show|start|done|strip|evo|block|defer)
      if [[ $COMP_CWORD -eq 2 ]]; then
        mapfile -t COMPREPLY < <(compgen -W \
          "$(jt json -a 2>/dev/null | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')" -- "$cur")
      fi ;;
    set)
      if [[ $COMP_CWORD -eq 2 ]]; then
        mapfile -t COMPREPLY < <(compgen -W \
          "$(jt json -a 2>/dev/null | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')" -- "$cur")
      elif [[ "$cur" == status=* ]]; then
        mapfile -t COMPREPLY < <(compgen -W \
          "status=todo status=ready status=doing status=investigating status=blocked status=testing status=deferred status=done" -- "$cur")
      elif [[ "$cur" == priority=* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "priority=P0 priority=P1 priority=P2 priority=P3" -- "$cur")
      elif [[ "$cur" == body=* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "body=-" -- "$cur")
      else
        mapfile -t COMPREPLY < <(compgen -W "status= priority= scope= body=" -- "$cur")
      fi ;;
    list|board)
      mapfile -t COMPREPLY < <(compgen -W "-a --all" -- "$cur") ;;
    json)
      mapfile -t COMPREPLY < <(compgen -W "-a --all -q --brief" -- "$cur") ;;
    new)
      case "$prev" in
        -p|--priority) mapfile -t COMPREPLY < <(compgen -W "P0 P1 P2 P3" -- "$cur") ;;
        -b|--blocked-by) mapfile -t COMPREPLY < <(compgen -W \
          "$(jt json -a 2>/dev/null | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')" -- "$cur") ;;
        *) mapfile -t COMPREPLY < <(compgen -W "-p -s -b --parent --body" -- "$cur") ;;
      esac ;;
    install)
      mapfile -t COMPREPLY < <(compgen -W "--dir -n --dry-run" -- "$cur") ;;
    grind)
      case "$prev" in
        --model) mapfile -t COMPREPLY < <(compgen -W "fable opus sonnet haiku" -- "$cur") ;;
        -C|--dir|--log) mapfile -t COMPREPLY < <(compgen -d -- "$cur") ;;
        *) mapfile -t COMPREPLY < <(compgen -W \
             "-r --rounds -C --dir --model --budget --command --log --here -n --dry-run" -- "$cur") ;;
      esac ;;
  esac
}
complete -F _jt jt
JTEOF
}

# jjui integration. Schema per jjui 0.10.x: [[actions]] takes name/desc/lua and
# may carry key/seq/scope directly. `t` is unbound in the top-level `revisions`
# scope and the defaults ship no seq bindings, so a t-prefixed chord is free.
#
# `context.change_id()` hands back jjui's `change_id.shortest()` — a prefix that
# is only unique against the CURRENT graph. Every action therefore expands it to
# the full change id in the shell ($(jj log … -T change_id)) before passing it to
# `jt`; the bare prefix is kept only for jjui-side use (flash, reselection).
comp_jjui() {
  # Composed rather than one heredoc so the template has a single definition
  # (task_template) shared with `jt list --tree`.
  printf '%s\n' "# >>> jt tasks — managed by \`jt install --jjui\`, edits here will be overwritten >>>"
  printf '%s\n' "# Task-aware log template — see \`jt list --tree\` for the same view in the shell."
  printf '[revisions]\ntemplate = %s\n%s%s\n\n' "'''" "$(task_template)" "'''"
  cat <<'JTEOF'
[[actions]]
name = "jt_status"
desc = "task: set status"
lua = '''
local id = context.change_id()
if not id then return end
local rev = "$(jj log --no-graph --ignore-working-copy -r " .. id .. " -T change_id)"
local s = choose({ options = {"todo","ready","doing","investigating","blocked","testing","deferred","done"}, title = "Task-Status" })
if s then
  exec_shell("jt set " .. rev .. " status=" .. s)
  revisions.refresh({ keep_selections = true })
  flash("status → " .. s)
end
'''
seq = ["t", "s"]
scope = "revisions"

[[actions]]
name = "jt_priority"
desc = "task: set priority"
lua = '''
local id = context.change_id()
if not id then return end
local rev = "$(jj log --no-graph --ignore-working-copy -r " .. id .. " -T change_id)"
local p = choose({ options = {"P0","P1","P2","P3"}, title = "Priority" })
if p then
  exec_shell("jt set " .. rev .. " priority=" .. p)
  revisions.refresh({ keep_selections = true })
  flash("priority → " .. p)
end
'''
seq = ["t", "p"]
scope = "revisions"

[[actions]]
name = "jt_new"
desc = "task: file a new one"
lua = '''
local s = input({ title = "New task", prompt = "summary: " })
if s and s ~= "" then
  exec_shell("jt new " .. string.format("%q", s))
  revisions.refresh()
  flash("filed: " .. s)
end
'''
seq = ["t", "n"]
scope = "revisions"

[[actions]]
name = "jt_block"
desc = "task: block with a reason"
lua = '''
local id = context.change_id()
if not id then return end
local rev = "$(jj log --no-graph --ignore-working-copy -r " .. id .. " -T change_id)"
local r = input({ title = "Block task", prompt = "reason: " })
if r and r ~= "" then
  exec_shell("jt block " .. rev .. " " .. string.format("%q", r))
  revisions.refresh({ keep_selections = true })
  flash("blocked")
end
'''
seq = ["t", "b"]
scope = "revisions"

[[actions]]
name = "jt_defer"
desc = "task: defer with a reason"
lua = '''
local id = context.change_id()
if not id then return end
local rev = "$(jj log --no-graph --ignore-working-copy -r " .. id .. " -T change_id)"
local r = input({ title = "Defer task", prompt = "reason: " })
if r and r ~= "" then
  exec_shell("jt defer " .. rev .. " " .. string.format("%q", r))
  revisions.refresh({ keep_selections = true })
  flash("deferred")
end
'''
seq = ["t", "D"]
scope = "revisions"

[[actions]]
name = "jt_done"
desc = "task: mark done"
lua = '''
local id = context.change_id()
if not id then return end
exec_shell("jt done $(jj log --no-graph --ignore-working-copy -r " .. id .. " -T change_id)")
revisions.refresh()
flash("done: " .. id)
'''
seq = ["t", "d"]
scope = "revisions"

[[actions]]
name = "jt_strip"
desc = "task: strip trailers, leaves the board"
lua = '''
local id = context.change_id()
if not id then return end
exec_shell("jt strip $(jj log --no-graph --ignore-working-copy -r " .. id .. " -T change_id)")
revisions.refresh()
flash("stripped: " .. id)
'''
seq = ["t", "r"]
scope = "revisions"

[[actions]]
name = "jt_start"
desc = "task: start (rebase onto tip, edit)"
lua = '''
local id = context.change_id()
if not id then return end
exec_shell("jt start $(jj log --no-graph --ignore-working-copy -r " .. id .. " -T change_id)")
revisions.refresh({ selected_revision = id })
flash("started: " .. id)
'''
seq = ["t", "S"]
scope = "revisions"

[[actions]]
name = "jt_list"
desc = "task: the whole board"
lua = '''
exec_shell("jt list | less -R")
'''
seq = ["t", "t"]
scope = "revisions"

[[actions]]
name = "jt_evo"
desc = "task: evolution trail"
lua = '''
local id = context.change_id()
if not id then return end
exec_shell("jt evo $(jj log --no-graph --ignore-working-copy -r " .. id .. " -T change_id) | less -R")
'''
seq = ["t", "e"]
scope = "revisions"
# <<< jt tasks <<<
JTEOF
}

# The template above emits label()s; jj — not jjui — resolves those to colours,
# so they belong in jj's config. Written as [colors.task_*] sub-tables because a
# second bare [colors] header would be a TOML duplicate-key error.
comp_jjcolors() { cat <<'JTEOF'
# >>> jt tasks — managed by `jt install --jjui`, edits here will be overwritten >>>
[colors.task_todo]
fg = "blue"
[colors.task_ready]
fg = "bright blue"
[colors.task_doing]
fg = "yellow"
[colors.task_investigating]
fg = "magenta"
[colors.task_blocked]
fg = "bright red"
[colors.task_testing]
fg = "bright yellow"
[colors.task_deferred]
fg = "white"
[colors.task_done]
fg = "bright black"
[colors.task_priority]
fg = "bright black"
[colors.task_needs]
fg = "bright black"
# <<< jt tasks <<<
JTEOF
}

# Append a marked block to $1, replacing any previous one. Idempotent.
append_block() {
  local f="$1" gen="$2"
  mkdir -p "$(dirname "$f")"
  [[ -f "$f" ]] || : > "$f"
  if grep -q '^# >>> jt tasks' "$f"; then
    sed -i '/^# >>> jt tasks/,/^# <<< jt tasks <<</d' "$f"
  fi
  printf '%s\n\n' "$(cat "$f")" > "$f.jt.tmp" && mv "$f.jt.tmp" "$f"
  "$gen" >> "$f"
}

install_jj_colors() {
  local cfg; cfg=$(jj config path --user 2>/dev/null) || cfg="$HOME/.config/jj/config.toml"
  append_block "$cfg" comp_jjcolors
  printf 'wrote task colours to %s\n' "$cfg"
}

install_jjui() {
  local cfg="${JJUI_CONFIG_DIR:-$HOME/.config/jjui}/config.toml"
  append_block "$cfg" comp_jjui
  printf 'wrote jjui template + actions to %s\n' "$cfg"
  install_jj_colors
  printf '  t t  board     t s  status     t p  priority  t n  new\n'
  printf '  t b  block     t d  done       t S  start     t e  evo\n'
  printf '  t D  defer     t r  strip\n'
  printf '  browse with: jt ui\n'
}

cmd_install() {
  local dir="${JT_CLAUDE_DIR:-$HOME/.claude/commands/jt}" dry=0 do_jjui=0
  local zdir="${JT_ZSH_DIR:-$HOME/.local/share/zsh/site-functions}"
  local fdir="${JT_FISH_DIR:-$HOME/.config/fish/completions}"
  local bdir="${JT_BASH_DIR:-$HOME/.local/share/bash-completion/completions}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      --jjui) do_jjui=1; shift ;;
      -n|--dry-run) dry=1; shift ;;
      *) die "usage: jt install [--dir <path>] [--jjui] [--dry-run]" ;;
    esac
  done
  local n
  if [[ $dry -eq 1 ]]; then
    printf 'slash commands → %s\n' "$dir"
    printf '  %s.md\n' file board start burst decide strip cleanup
    printf 'completions:\n'
    printf '  %s/_jt\n  %s/jt.fish\n  %s/jt\n' "$zdir" "$fdir" "$bdir"
    [[ $do_jjui -eq 1 ]] && printf 'jjui actions → %s/config.toml (appended, marked block)\n' \
      "${JJUI_CONFIG_DIR:-$HOME/.config/jjui}"
    return
  fi
  mkdir -p "$dir"
  for n in file board start burst decide strip cleanup; do
    "md_$n" > "$dir/$n.md"
    printf 'wrote %s/%s.md  → /jt:%s\n' "$dir" "$n" "$n"
  done
  mkdir -p "$zdir" "$fdir" "$bdir"
  comp_zsh  > "$zdir/_jt";     printf 'wrote %s/_jt\n' "$zdir"
  comp_fish > "$fdir/jt.fish"; printf 'wrote %s/jt.fish\n' "$fdir"
  comp_bash > "$bdir/jt";      printf 'wrote %s/jt\n' "$bdir"
  [[ $do_jjui -eq 1 ]] && install_jjui
  printf '\nRestart Claude Code (or start a new session) to pick up the commands.\n'
  case ":${FPATH:-}:" in
    *":$zdir:"*) : ;;
    *) printf 'For zsh completions, add to ~/.zshrc BEFORE compinit:\n  fpath=(%s $fpath)\n' "$zdir" ;;
  esac
}

usage() {
  cat <<'EOF'
jt — task tracker on jj changes. A task is a change with a Task-Status: trailer.

  jt [list] [-a] [-t]         board of open tasks (-a includes done,
                              -t draws the DAG instead of priority order)
  jt json [-a] [-q]           same, as JSONL — for scripts and agents
                              (-q drops bodies: ~10x smaller, poll with it)
  jt new <summary> [flags]    file a task
       -p P1  -s <scope>  -b <blocker-id>  --parent <rev>  --body <text>
  jt show <id>                full description
  jt set <id> key=val...      status= priority= scope= body= (body=- reads
                              stdin), or any Trailer-Key=
  jt start <id>               rebase onto work tip, mark doing, jj edit it
  jt done <id>                mark done (stays on the graph, drops off the
                              default board; trailers stay until `jt strip`)
  jt strip <id>               strip trailers — leaves the board, clean commit
  jt block <id> [reason]      mark blocked, appending the reason
  jt defer <id> [reason]      mark deferred, appending the reason
  jt evo <id>                 evolution trail: status/priority/checklist changes
  jt tip                      the current work tip
  jt ui [jjui args]           browse the task graph in jjui
  jt grind [-r N] [-C ws]     work batches unattended: one fresh `claude -p`
                              per batch, so context resets between them
                              (`jt grind --help` for the rest)
  jt install [--dir P] [-n] [--jjui]
                              write the /jt:* slash commands, shell completions,
                              and (with --jjui) jjui task actions

  --ignore-immutable          global flag, any position: forwarded to the
                              underlying jj rebase/edit/describe calls
                              (start, set, strip, block, defer)

<id> is a change-id prefix — ids only, never a text search.
Statuses: todo ready doing investigating blocked testing deferred done
  testing  — implementation done, waiting on the user to confirm before `jt done`
  done     — confirmed complete but not yet cleaned up; `/jt:cleanup` tidies
             the message and runs `jt strip` to take it off the graph for good
  deferred — shelved: never ready, never surfaced by /jt:decide
EOF
}

# --ignore-immutable is a global flag, valid anywhere in the args, stripped
# here and threaded through to the jj rebase/edit/describe calls below that
# can otherwise refuse to touch an immutable commit.
JJ_IGNORE_IMMUTABLE=()
filtered=()
for a in "$@"; do
  if [[ "$a" == "--ignore-immutable" ]]; then
    JJ_IGNORE_IMMUTABLE=(--ignore-immutable)
  else
    filtered+=("$a")
  fi
done
set -- "${filtered[@]}"

case "${1:-list}" in
  -h|--help|help) usage; exit 0 ;;
  install)        shift; cmd_install "$@"; exit 0 ;;
esac
jj root >/dev/null 2>&1 || die "not in a jj repo"

case "${1:-list}" in
  list|board|ls) shift || true; cmd_list "$@" ;;
  json)          shift; cmd_json "$@" ;;
  new|add|todo)  shift; cmd_new "$@" ;;
  show|view)     shift; cmd_show "$@" ;;
  set)           shift; cmd_set "$@" ;;
  start)         shift; cmd_start "$@" ;;
  done)          shift; cmd_done "$@" ;;
  strip)         shift; cmd_strip "$@" ;;
  block)         shift; cmd_block "$@" ;;
  defer)         shift; cmd_defer "$@" ;;
  evo|taskevo)   shift; cmd_evo "$@" ;;
  ui|jjui)       shift; cmd_ui "$@" ;;
  grind)         shift; cmd_grind "$@" ;;
  tip)           cmd_tip ;;
  -h|--help|help) usage ;;
  *) die "unknown command '$1' (try: jt --help)" ;;
esac
